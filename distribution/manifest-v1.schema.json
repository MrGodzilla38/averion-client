{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Averion Client release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "clientVersion", "channel", "sequence", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "clientVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "channel": { "enum": ["stable", "preview"] },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "stable" } } },
      "then": { "properties": { "clientVersion": { "not": { "pattern": "-" } } } },
      "else": { "properties": { "clientVersion": { "pattern": "-" } } }
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minecraftVersion", "javaMajor", "fabricLoaderVersion", "artifact", "requiredDependencies"],
      "properties": {
        "minecraftVersion": { "type": "string", "maxLength": 32, "pattern": "^[0-9]+(\\.[0-9]+){1,2}$" },
        "javaMajor": { "type": "integer", "minimum": 8, "maximum": 255 },
        "fabricLoaderVersion": { "type": "string", "maxLength": 32, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "artifact": {
          "$ref": "#/$defs/file",
          "properties": {
            "fileName": { "pattern": "^averion-client-[0-9]+(\\.[0-9]+){1,2}\\.jar$" }
          }
        },
        "requiredDependencies": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/dependency" }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "url", "size", "sha256"],
      "properties": {
        "fileName": { "type": "string", "maxLength": 200, "pattern": "^[0-9A-Za-z](?:[0-9A-Za-z._+ -]|%2[Bb])*\\.jar$" },
        "url": { "type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modId", "provider", "projectId", "versionId", "sha512", "file"],
      "properties": {
        "modId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
        "provider": { "const": "modrinth" },
        "projectId": { "type": "string", "pattern": "^[0-9A-Za-z]{8}$" },
        "versionId": { "type": "string", "pattern": "^[0-9A-Za-z]{8}$" },
        "sha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" },
        "file": { "$ref": "#/$defs/file" }
      }
    }
  }
}
